{
  "name": "p2-cool-campus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "清凉校园 · 热浪行动：校园微气候改善决策游戏（原型模拟）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "mp:build": "tsc -p tsconfig.mp.json && node mp-fix-requires.cjs",
    "mp:smoke": "node mp-smoke.cjs && node mp-smoke-page.cjs",
    "gen:shots": "node scripts/verify-shots.mjs",
    "build:portable": "vite build && node scripts/make-portable.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
